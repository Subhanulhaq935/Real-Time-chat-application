# App Configuration
APP_NAME="Real-Time Chat API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/chatapp_db"

# Security (JWT / Secret Keys - to be used in future phases)
SECRET_KEY="your-super-secret-key-change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP / Email Configuration (Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-gmail-app-password"
EMAILS_FROM_EMAIL="your-email@gmail.com"
EMAILS_FROM_NAME="Real-Time Chat App"

# OTP Policy Configuration
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

